{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensemanticagent.org/schemas/subscription.schema.json",
  "title": "Open Semantic Agent Subscription Manifest",
  "type": "object",
  "required": [
    "subscriber",
    "match"
  ],
  "properties": {
    "subscriber": {
      "type": "string"
    },
    "match": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "topics"
          ]
        },
        {
          "required": [
            "intent"
          ]
        }
      ],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intent": {
          "type": "string"
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.75
        },
        "accept_above": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Tier 1 auto-accept edge (0.2); default threshold + delta, 1 = never"
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Tier 2 matches below this confidence are not delivered (0.2)"
        },
        "mode": {
          "enum": [
            "all",
            "any"
          ],
          "default": "all"
        }
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "detail": {
          "enum": [
            "full",
            "summary",
            "headline"
          ],
          "default": "full"
        }
      }
    },
    "clearance": {
      "enum": [
        "pii:none",
        "pii:masked",
        "pii:full"
      ],
      "default": "pii:none"
    },
    "dedupe": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "default": 0.9
        },
        "window": {
          "type": "string",
          "default": "10m"
        },
        "cross_trace": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "realtime",
            "digest"
          ],
          "default": "realtime"
        },
        "digest_window": {
          "type": "string"
        },
        "max_lag": {
          "type": "integer"
        },
        "overflow": {
          "enum": [
            "summarize",
            "drop_oldest",
            "block"
          ],
          "default": "summarize"
        },
        "replay_window": {
          "type": "string",
          "description": "Streams may resume within this window (0.3, §9.3), for example 10m"
        },
        "notify": {
          "type": "object",
          "required": [
            "channels"
          ],
          "additionalProperties": false,
          "properties": {
            "channels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "recipient"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "webpush",
                      "apns",
                      "fcm",
                      "email"
                    ]
                  },
                  "recipient": {
                    "type": "string",
                    "pattern": "^contact://"
                  }
                }
              }
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min_severity": {
                  "enum": [
                    "info",
                    "warning",
                    "critical"
                  ],
                  "default": "warning"
                },
                "states": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "firing",
                      "resolved"
                    ]
                  },
                  "default": [
                    "firing"
                  ]
                },
                "cooldown": {
                  "type": "string",
                  "pattern": "^[0-9]+[smh]$",
                  "default": "15m"
                },
                "max_per_hour": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 20
                },
                "quiet_hours": {
                  "type": "object",
                  "required": [
                    "start",
                    "end",
                    "tz"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "end": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "tz": {
                      "type": "string",
                      "minLength": 1,
                      "description": "An IANA time zone, for example Asia/Dubai"
                    },
                    "allow": {
                      "enum": [
                        "none",
                        "critical"
                      ],
                      "default": "critical"
                    }
                  }
                }
              }
            },
            "content": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "detail": {
                  "enum": [
                    "headline",
                    "summary"
                  ],
                  "default": "headline"
                },
                "with_advice": {
                  "type": "boolean",
                  "default": true
                },
                "allow_content": {
                  "type": "boolean",
                  "default": false,
                  "description": "Let text from envelopes marked content into notifications, on end-to-end encrypted channels only"
                }
              }
            },
            "escalate": {
              "type": "object",
              "required": [
                "after",
                "to"
              ],
              "additionalProperties": false,
              "properties": {
                "after": {
                  "type": "string",
                  "pattern": "^[0-9]+[smh]$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^contact://"
                }
              }
            }
          },
          "description": "Tell people about matched items (0.5, §9.4)"
        }
      }
    },
    "model_policy": {
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "auto",
            "max_tier_1",
            "strict"
          ],
          "default": "auto"
        },
        "budget_tokens_per_hour": {
          "type": "integer"
        },
        "on_budget_exhausted": {
          "enum": [
            "threshold",
            "skip"
          ],
          "default": "threshold"
        },
        "prefer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
