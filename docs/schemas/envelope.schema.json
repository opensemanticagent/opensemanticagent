{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensemanticagent.org/schemas/envelope.schema.json",
  "title": "Open Semantic Agent Envelope",
  "type": "object",
  "required": [
    "spec",
    "id",
    "source",
    "time",
    "data"
  ],
  "properties": {
    "spec": {
      "type": "string",
      "pattern": "^osa/\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "content_type": {
      "type": "string",
      "default": "application/json"
    },
    "schema_ref": {
      "type": "string"
    },
    "data": {},
    "hints": {
      "type": "object",
      "properties": {
        "urgency": {
          "enum": [
            "auto",
            "low",
            "normal",
            "high",
            "critical"
          ]
        },
        "strict": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "labels": {
      "type": "object",
      "properties": {
        "pii": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitivity": {
          "enum": [
            "metadata",
            "content",
            "secret"
          ],
          "description": "Class of the whole payload (0.3, §3)"
        }
      }
    },
    "osa": {
      "type": "object",
      "description": "Reserved for fields derived by the bus",
      "properties": {
        "intent": {
          "type": "string"
        },
        "urgency": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "message",
            "digest",
            "briefing",
            "repair",
            "rollup"
          ]
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "window": {
          "type": "string"
        }
      }
    },
    "subject": {
      "type": "string",
      "description": "What the envelope is about, when not the producer (0.3, §3). A URI such as device://, svc://, agent://, process://"
    },
    "correlation": {
      "type": "object",
      "description": "Links to related work (0.3, §3)",
      "additionalProperties": true,
      "properties": {
        "session": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "description": "id of the envelope that caused this one"
        },
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
          "description": "W3C Trace Context traceparent"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content_type": {
            "const": "application/vnd.osa.metrics+json"
          }
        },
        "required": [
          "content_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "https://opensemanticagent.org/schemas/metrics.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content_type": {
            "const": "application/vnd.osa.alert+json"
          }
        },
        "required": [
          "content_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "https://opensemanticagent.org/schemas/alert.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content_type": {
            "const": "application/vnd.osa.recommendation+json"
          }
        },
        "required": [
          "content_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "https://opensemanticagent.org/schemas/recommendation.schema.json"
          }
        }
      }
    }
  ]
}
