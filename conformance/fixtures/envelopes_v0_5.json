  {
   "name": "manifest with delivery.notify: channels, rules, content, escalation",
   "schema": "subscription",
   "document": {
    "subscriber": "oncall-phone",
    "match": {
     "topics": [
      "alert.*"
     ]
    },
    "delivery": {
     "mode": "realtime",
     "notify": {
      "channels": [
       {
        "type": "webpush",
        "recipient": "contact://oncall/alice"
       }
      ],
      "when": {
       "min_severity": "warning",
       "states": [
        "firing"
       ],
       "cooldown": "15m",
       "max_per_hour": 20,
       "quiet_hours": {
        "start": "22:00",
        "end": "07:00",
        "tz": "Asia/Dubai",
        "allow": "critical"
       }
      },
      "content": {
       "detail": "headline",
       "with_advice": true
      },
      "escalate": {
       "after": "10m",
       "to": "contact://oncall/backup"
      }
     }
    }
   },
   "valid": true
  },
  {
   "name": "manifest channel with a raw device token",
   "schema": "subscription",
   "document": {
    "subscriber": "oncall-phone",
    "match": {
