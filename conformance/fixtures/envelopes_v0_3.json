  "handling": [
    {
      "name": "content without hints.strict is strict",
      "envelope": {
        "spec": "osa/0.3",
        "id": "v03-20",
        "source": "device://sensor-7",
        "time": "2026-11-22T09:24:03Z",
        "labels": {
          "sensitivity": "content"
        },
        "data": {
          "text": "..."
        }
      },
      "expect": {
        "strict": true
      }
    },
    {
      "name": "content with hints.strict false may reach models",
