    {
      "name": "subscription with replay window",
      "schema": "subscription",
      "document": {
        "subscriber": "phone",
        "match": {
          "topics": [
            "alert.*"
          ]
        },
        "delivery": {
          "mode": "realtime",
          "replay_window": "10m"
        }
      },
      "valid": true
    },
    {
      "name": "stream resume op",
      "schema": "stream",
      "document": {
        "op": "subscribe",
        "subscriber": "phone",
        "resume_after": "v03-7"
      },
      "valid": true
    }
